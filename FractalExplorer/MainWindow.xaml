<Window x:Class="FractalExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FractalExplorer"
        Height="760"
        Width="1220"
        MinHeight="600"
        MinWidth="980"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="#1E1E1E"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <Label Content="Typ fraktálu" />
                <ComboBox x:Name="cmbFractalType" SelectionChanged="cmbFractalType_SelectionChanged">
                    <ComboBoxItem Content="Mandelbrot" />
                    <ComboBoxItem Content="Julia" />
                </ComboBox>

                <Label Content="Barevná paleta" />
                <ComboBox x:Name="cmbPalette">
                    <ComboBoxItem Content="Fire" />
                    <ComboBoxItem Content="Ocean" />
                    <ComboBoxItem Content="Rainbow" />
                </ComboBox>

                <Label Content="Počet iterací" />
                <Slider x:Name="sldIterations"
                        Minimum="20"
                        Maximum="500"
                        Value="100"
                        TickFrequency="20"
                        IsSnapToTickEnabled="False"
                        ValueChanged="sldIterations_ValueChanged" />
                <TextBlock x:Name="lblIterationValue"
                           Margin="0,2,0,8"
                           Foreground="#A8A8A8"
                           Text="100" />

                <Border x:Name="juliaPanel"
                        Margin="0,4,0,8"
                        Padding="10"
                        Background="#252526"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Label Margin="0,0,0,4" Content="Julia konstanta (c)" />
                        <TextBlock Margin="0,0,0,2" Foreground="#D0D0D0" Text="Reálná část" />
                        <TextBox x:Name="txtJuliaReal" Text="-0.7" />
                        <TextBlock Margin="0,2,0,2" Foreground="#D0D0D0" Text="Imaginární část" />
                        <TextBox x:Name="txtJuliaImaginary" Text="0.27" Margin="0,0,0,0" />
                    </StackPanel>
                </Border>

                <Button x:Name="btnRender"
                        Content="🎨 Vykreslit"
                        Height="40"
                        Margin="0,8,0,8"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="btnRender_Click" />

                <Button x:Name="btnReset"
                        Content="🔍 Reset pohledu"
                        Height="34"
                        Margin="0,0,0,10"
                        Background="#3C3C3C"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnReset_Click" />

                <ProgressBar x:Name="prgRender"
                             Height="16"
                             Margin="0,0,0,8"
                             Minimum="0"
                             Maximum="100" />

                <TextBlock x:Name="lblStatus"
                           Margin="0,0,0,8"
                           Foreground="#D8D8D8"
                           Text="Připraveno" />

                <TextBlock Foreground="#AFAFAF"
                           FontStyle="Italic"
                           FontSize="12"
                           Text="Scroll = zoom&#10;Drag = pohyb" />
            </StackPanel>
        </Border>

        <Border Background="Black" Margin="8">
            <Image x:Name="fractalImage"
                   Stretch="Uniform"
                   Cursor="Cross"
                   MouseWheel="fractalImage_MouseWheel"
                   MouseDown="fractalImage_MouseDown"
                   MouseMove="fractalImage_MouseMove"
                   MouseUp="fractalImage_MouseUp" />
        </Border>
    </DockPanel>
</Window>
